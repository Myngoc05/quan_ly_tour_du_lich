# Cổng chạy server (Railway/Render tự set PORT, không cần đổi khi deploy)
PORT=4000

# Khóa bí mật để ký JWT - PHẢI đổi thành chuỗi ngẫu nhiên dài khi deploy thật
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Đường dẫn file database SQLite (Railway: dùng Volume để không mất dữ liệu khi redeploy)
DB_PATH=./data/travelgo.db

# Tài khoản admin khởi tạo sẵn (đổi mật khẩu ngay sau khi deploy)
ADMIN_EMAIL=admin@travelgo.vn
ADMIN_PASSWORD=admin123

# ==== Cổng thanh toán VNPay (điền khi có tài khoản merchant thật) ====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/payments/vnpay-return

# ==== Cổng thanh toán Momo (điền khi có tài khoản merchant thật) ====
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
